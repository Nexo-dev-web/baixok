# Configuracao local. Este arquivo esta no .gitignore e nunca vai para o Git.
#
# Copiado do .env.example so com o que a migracao para o Supabase precisa agora.
# Para a lista completa de variaveis, veja o .env.example.

NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------ Supabase ---
# ATENCAO: as duas linhas abaixo sao coisas DIFERENTES.
#
# SUPABASE_URL e o endereco publico da API (o que aparece no navegador do
# cliente). SUPABASE_DATABASE_URL e a conexao com o Postgres e carrega a SENHA
# do banco — nunca vai para o front, nunca vai para o Git, nunca vai colada em
# conversa.

SUPABASE_URL=https://ummujbilasmlwuottubt.supabase.co

# Onde achar: painel do Supabase -> botao "Connect" no topo -> aba
# "Connection string" -> escolha "Session pooler".
#
# Host e usuario ja conferidos (regiao us-west-2). Falta so a senha: troque
# SENHA_DO_BANCO abaixo e tire o # da frente da linha.
#
# Por que Session pooler e nao "Direct connection": a conexao direta do Supabase
# so atende por IPv6, e a maioria dos hosts (e provavelmente a sua rede) nao
# tem. O pooler atende por IPv4 e resolve isso.
#
# Por que porta 5432 (session) e nao 6543 (transaction): o backend roda como
# processo longo e mantem um pool proprio de conexoes. O modo transaction e para
# ambiente serverless, onde cada chamada abre e fecha a conexao.
#
SUPABASE_DATABASE_URL=postgresql://postgres.ummujbilasmlwuottubt:nexowebnexo@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Chave secreta do Supabase, usada so pelo Auth no servidor. A service_role
# ignora RLS por completo: ela nunca pode chegar ao navegador.
# SUPABASE_SERVICE_ROLE_KEY=
